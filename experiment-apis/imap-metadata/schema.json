[
  {
    "namespace": "imapMetadata",
    "description": "API to access IMAP METADATA for TMail labels synchronization. Labels are read-only: only GETMETADATA is used.",
    "types": [
      {
        "id": "TMailLabel",
        "type": "object",
        "description": "A TMail label definition",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier of the label (from METADATA path)"
          },
          "keyword": {
            "type": "string",
            "description": "IMAP keyword (UUID) associated with this label"
          },
          "displayName": {
            "type": "string",
            "description": "Human-readable name of the label"
          },
          "color": {
            "type": "string",
            "optional": true,
            "description": "Color of the label in hex format"
          }
        }
      },
      {
        "id": "MetadataResult",
        "type": "object",
        "description": "Result of a GETMETADATA operation",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "labels": {
            "type": "array",
            "items": {
              "$ref": "TMailLabel"
            },
            "optional": true
          },
          "error": {
            "type": "string",
            "optional": true
          }
        }
      },
      {
        "id": "ImapAccount",
        "type": "object",
        "description": "An IMAP account that may support TMail labels",
        "properties": {
          "id": {
            "type": "string",
            "description": "Account identifier"
          },
          "name": {
            "type": "string",
            "description": "Account display name"
          },
          "serverHost": {
            "type": "string",
            "description": "IMAP server hostname"
          },
          "username": {
            "type": "string",
            "description": "Username for this account"
          }
        }
      },
      {
        "id": "TwakeIdentity",
        "type": "object",
        "description": "A Twake Mail identity from IMAP METADATA",
        "properties": {
          "id": { "type": "string", "description": "Identity UUID" },
          "hash": { "type": "string", "description": "Murmur3 hash of the UUID (METADATA path key)" },
          "displayName": { "type": "string" },
          "email": { "type": "string" },
          "sortOrder": { "type": "integer", "optional": true },
          "htmlSignature": { "type": "string", "optional": true },
          "textSignature": { "type": "string", "optional": true },
          "mayDelete": { "type": "boolean" },
          "replyTo": { "type": "string", "optional": true },
          "bcc": { "type": "string", "optional": true }
        }
      }
    ],
    "functions": [
      {
        "name": "getLabels",
        "type": "function",
        "description": "Fetch TMail labels from IMAP METADATA for a specific account/folder",
        "async": "callback",
        "parameters": [
          {
            "name": "accountId",
            "type": "string",
            "description": "The account ID to fetch labels from"
          },
          {
            "name": "folderPath",
            "type": "string",
            "optional": true,
            "default": "INBOX",
            "description": "The folder path (defaults to INBOX)"
          },
          {
            "name": "callback",
            "type": "function",
            "parameters": [
              {
                "$ref": "MetadataResult"
              }
            ]
          }
        ]
      },
      {
        "name": "getImapAccounts",
        "type": "function",
        "description": "Get list of IMAP accounts",
        "async": "callback",
        "parameters": [
          {
            "name": "callback",
            "type": "function",
            "parameters": [
              {
                "type": "array",
                "items": {
                  "$ref": "ImapAccount"
                }
              }
            ]
          }
        ]
      },
      {
        "name": "getIdentities",
        "type": "function",
        "description": "Fetch Twake Mail identities from IMAP METADATA for a specific account",
        "async": "callback",
        "parameters": [
          {
            "name": "accountId",
            "type": "string",
            "description": "The account ID to fetch identities from"
          },
          {
            "name": "callback",
            "type": "function",
            "parameters": [
              {
                "type": "object",
                "properties": {
                  "success": { "type": "boolean" },
                  "identities": {
                    "type": "array",
                    "items": { "$ref": "TwakeIdentity" },
                    "optional": true
                  },
                  "error": { "type": "string", "optional": true }
                }
              }
            ]
          }
        ]
      },
      {
        "name": "testConnection",
        "type": "function",
        "description": "Test if an account supports TMail METADATA labels",
        "async": "callback",
        "parameters": [
          {
            "name": "accountId",
            "type": "string"
          },
          {
            "name": "callback",
            "type": "function",
            "parameters": [
              {
                "type": "object",
                "properties": {
                  "supported": { "type": "boolean" },
                  "error": { "type": "string", "optional": true }
                }
              }
            ]
          }
        ]
      }
    ],
    "events": [
      {
        "name": "onLabelsChanged",
        "type": "function",
        "description": "Fired when labels change on the server",
        "parameters": [
          {
            "name": "accountId",
            "type": "string"
          },
          {
            "name": "labels",
            "type": "array",
            "items": {
              "$ref": "TMailLabel"
            }
          }
        ]
      }
    ]
  }
]
